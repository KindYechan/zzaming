<?xml version="1.0" encoding="utf-8"?>
<!--
    sheet_join.xml — "기존 행정반에 들어가기" 를 누르면 올라오는 가입 시트

    [변경] 예전에는 이름, 계급, 추천인, 부대 호칭을 입력받았어요.
           이름과 계급은 회원가입 때 이미 알고 있어서 지우고, 부대 코드 하나만 받아요.
           부대 코드는 행정반을 만든 사람의 행정반 화면 맨 위에 보여요.

    바텀시트 = 화면 아래에서 올라오는 창. Java에서 이렇게 띄워요:
      BottomSheetDialog sheet = new BottomSheetDialog(this);
      SheetJoinBinding sheetBinding = SheetJoinBinding.inflate(getLayoutInflater());
      sheet.setContentView(sheetBinding.getRoot());
      sheet.show();
    닫기: btn_close 를 누르면 sheet.dismiss();
-->
<!-- 시트가 길어져도 키보드에 가려지지 않게 전체를 ScrollView 로 감쌌어요 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="21dp"
    android:paddingTop="23dp"
    android:paddingEnd="21dp"
    android:paddingBottom="24dp">

    <!-- 머리: 작은 머리말 + 제목 | 닫기(X) 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_kicker"
                style="@style/JjamText.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_kicker" />

            <TextView
                android:id="@+id/tv_sheet_title"
                style="@style/JjamText.SheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/join_title" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/action_close"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/icon_default" />
    </LinearLayout>

    <!-- 안내: 이름·계급은 회원가입 정보를 쓴다는 걸 알려 줘요 -->
    <TextView
        style="@style/JjamText.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/join_desc" />

    <!-- 입력 폼: 부대 코드 하나 -->
    <TextView
        style="@style/JjamText.FormLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/label_unit_code" />

    <!-- textCapCharacters: 키보드가 대문자로 나와요 / maxLength: 6글자까지만 -->
    <EditText
        android:id="@+id/et_unit_code"
        style="@style/JjamInput"
        android:autofillHints=""
        android:hint="@string/hint_unit_code"
        android:inputType="textCapCharacters"
        android:maxLength="6" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit"
        style="@style/JjamButton"
        android:layout_width="match_parent"
        android:layout_marginTop="22dp"
        android:text="@string/join_submit" />

</LinearLayout>
</ScrollView>
